{
  "name": "rontye",
  "version": "0.3.0",
  "description": "A local AI gateway, firewall and sandbox for your agents.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": "github:openguardrails/rontye",
  "bin": {
